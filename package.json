{
  "name": "zk-poap",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy-preserving proofs of event participation",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thryec/zk-poap.git"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "constants:check": "pnpm --filter @pop/circuits check:constants",
    "circuit:compile": "pnpm --filter @pop/circuits compile",
    "ptau:fetch": "pnpm --filter @pop/circuits ptau",
    "artifacts:setup": "pnpm --filter @pop/circuits setup:dev && pnpm --filter @pop/circuits manifest:dev",
    "credential:create": "pnpm --filter @pop/circuits credential:create",
    "proof:generate": "pnpm --filter @pop/circuits proof:generate",
    "proof:verify": "pnpm --filter @pop/circuits proof:verify",
    "proof:tamper": "pnpm --filter @pop/circuits proof:tamper",
    "proof:signals": "pnpm --filter @pop/circuits proof:signals",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check": "pnpm check:toolchain && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "typescript": "7.0.2"
  }
}
