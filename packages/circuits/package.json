{
  "name": "@pop/circuits",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "artifacts:dev": "pnpm check:constants && pnpm compile && pnpm ptau && pnpm setup:dev && pnpm manifest:dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "check:constants": "tsx scripts/emit-constants.ts --check",
    "compile": "node scripts/compile.mjs",
    "example": "pnpm artifacts:dev && node --import tsx scripts/demo.mjs",
    "manifest:dev": "node scripts/artifact-manifest.mjs",
    "prove:smoke": "node --import tsx scripts/prove-smoke.mjs",
    "ptau": "node scripts/fetch-ptau.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pop/protocol": "workspace:*",
    "circomlib": "2.0.5",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/snarkjs": "0.7.9",
    "circom_tester": "0.0.24",
    "tsx": "catalog:",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
